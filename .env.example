# Copy to .env and fill in. Only the selected LLM provider key is required for live analysis.

# Which provider the agent uses: "anthropic", "openai", or "deepseek".
LLM_PROVIDER=deepseek

# DeepSeek's OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Anthropic. Required only when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI. Required only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Local JobIntel database.
JOBINTEL_DB_PATH=data/jobintel.db

# Agent loop safety guards.
AGENT_MAX_ITERATIONS=12
AGENT_MAX_REPAIRS=2
AGENT_MAX_TOOL_CALLS=60
PARSER_MAX_REPAIRS=2
OUTREACH_MAX_REPAIRS=2

# Shared SMTP sender for discovery notifications. Set each recipient in the Web UI.
# QQ 邮箱 SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_TRANSPORT=ssl

# 完整 QQ 邮箱地址
SMTP_USERNAME=your-account@qq.com

# QQ 邮箱生成的 SMTP 授权码，不是 QQ 登录密码
SMTP_PASSWORD=your-smtp-authorization-code

# 通常必须与 SMTP_USERNAME 相同
SMTP_FROM_ADDRESS=your-account@qq.com

SMTP_TIMEOUT_SECONDS=15

# BOSS discovery through the local Chrome CDP bridge.
DISCOVERY_CDP_PORT=9222
DISCOVERY_TIMEOUT_SECONDS=12
DISCOVERY_MAX_WORKERS=4
# Conservative defaults: search pages and job details are fetched serially with jitter.
DISCOVERY_SEARCH_MIN_DELAY_SECONDS=1.2
DISCOVERY_SEARCH_MAX_DELAY_SECONDS=2.4
DISCOVERY_DETAIL_MIN_DELAY_SECONDS=3.0
DISCOVERY_DETAIL_MAX_DELAY_SECONDS=6.0
# Reuse a successfully fetched full JD instead of requesting it again during this window.
DISCOVERY_DETAIL_CACHE_HOURS=24
# Do not revisit the same saved search more frequently than this by default.
RADAR_MIN_INTERVAL_HOURS=6
